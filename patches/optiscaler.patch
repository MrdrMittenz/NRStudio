+// Dedicated NR Studio front panel. It edits the same options consumed by the
+// native pass; no polling of a desktop process or second injection layer is needed.
+bool RenderStudioMenu(Config* config, float scale)
+{
+    const auto display = ImGui::GetIO().DisplaySize;
+    ImGui::SetNextWindowSize(ImVec2(std::min(620.0f * scale, display.x * 0.92f),
+                                  std::min(690.0f * scale, display.y * 0.90f)), ImGuiCond_FirstUseEver);
+    ImGui::SetNextWindowPos(ImVec2(display.x * 0.04f, display.y * 0.05f), ImGuiCond_FirstUseEver);
+    ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0.055f, 0.080f, 0.115f, 0.97f));
+    ImGui::PushStyleColor(ImGuiCol_CheckMark, ImVec4(0.42f, 0.87f, 0.74f, 1.0f));
+    ImGui::PushStyleColor(ImGuiCol_SliderGrab, ImVec4(0.42f, 0.87f, 0.74f, 1.0f));
+    bool advanced = false;
+    if (ImGui::Begin("NR STUDIO | Live neural rendering", nullptr,
+                     ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoSavedSettings))
+    {
+        ImGui::TextColored(ImVec4(0.42f, 0.87f, 0.74f, 1.0f), "NR STUDIO");
+        ImGui::SameLine();
+        ImGui::TextDisabled("Insert to return to your game");
+        bool enabled = config->DlssNrEnabled.value_or_default();
+        if (ImGui::Checkbox("Neural rendering enabled", &enabled)) config->DlssNrEnabled = enabled;
+        if (DlssNr::IsRunning() && enabled)
+        {
+            auto ms = DlssNr::LastGpuTime();
+            if (ms.has_value()) ImGui::Text("Native NR running | GPU pass: %.2f ms", ms.value());
+            else ImGui::TextUnformatted("Native NR running | GPU timing pending");
+        }
+        else if (!enabled) ImGui::TextUnformatted("NR disabled | Original upscaler output");
+        else if (DlssNr::FailureReason()[0])
+        {
+            ImGui::TextWrapped("NR unavailable: %s", DlssNr::FailureReason());
+            if (ImGui::Button("Retry NR")) DlssNr::RetryAfterFailure();
+        }
+        else ImGui::TextUnformatted("Waiting for native DLSS frames. Select DLSS in the game.");
+
+        static int saveResult = 0;
+        if (ImGui::Button("Save profile")) saveResult = config->SaveIni() ? 1 : -1;
+        ImGui::SameLine();
+        if (ImGui::Button("Advanced OptiScaler")) advanced = true;
+        if (saveResult == 1) ImGui::TextDisabled("Profile saved for future launches.");
+        if (saveResult == -1) ImGui::TextUnformatted("Could not save. Check write access to the game folder.");
+        ImGui::TextDisabled("Powered by OptiScaler and the native NR model");
+        ImGui::Separator();
+        ImGui::PushItemWidth(ImGui::GetContentRegionAvail().x * 0.53f);
+
+        auto live = [](const char* label, CustomOptional<float>* opt, float lo, float hi) {
+            float value = opt->value_or_default();
+            if (ImGui::SliderFloat(label, &value, lo, hi, "%.2f", ImGuiSliderFlags_AlwaysClamp))
+                *opt = value;
+        };
+        ImGui::SeparatorText("Live appearance");
+        live("Detail strength", &config->DlssNrTransferStrength, 0.0f, 2.0f);
+        live("Colour strength", &config->DlssNrColourStrength, 0.0f, 1.0f);
+        live("Paper white", &config->DlssNrWhitePointScale, 0.25f, 4.0f);
+        live("Highlight guard", &config->DlssNrMaxRatio, 1.0f, 8.0f);
+
+        ImGui::SeparatorText("Compare with original");
+        const char* modes[] = { "Off", "Side by side", "Wipe" };
+        int mode = static_cast<int>(config->DlssNrCompare.value_or_default());
+        if (ImGui::Combo("Comparison", &mode, modes, 3)) config->DlssNrCompare = static_cast<uint32_t>(mode);
+        if (mode == 2) live("Wipe position", &config->DlssNrCompareSplit, 0.0f, 1.0f);
+        if (mode != 0)
+        {
+            bool tags = config->DlssNrCompareTags.value_or_default();
+            if (ImGui::Checkbox("Label original and NR", &tags)) config->DlssNrCompareTags = tags;
+        }
+
+        ImGui::SeparatorText("Experimental performance");
+        const char* composeModes[] = { "Current composition", "Matched residual (experimental)" };
+        int composeMode = config->DlssNrComposeMode.value_or_default() == 1 ? 1 : 0;
+        if (ImGui::Combo("Composition", &composeMode, composeModes, 2))
+            config->DlssNrComposeMode = static_cast<uint32_t>(composeMode);
+        if (composeMode == 1)
+        {
+            live("Residual tone", &config->DlssNrResidualTone, 0.0f, 2.0f);
+            live("Residual detail", &config->DlssNrResidualDetail, 0.0f, 2.0f);
+            ImGui::TextWrapped("Adds the model's matched edit to the original frame. Tone controls broad changes; detail controls finer changes. Lower resolution can change the result: compare fine patterns and motion before choosing a scale.");
+        }
+        bool upstreamRequested = BeforeUpscaleRequested();
+        if (ImGui::Checkbox("NR before upscaling (restart required)", &upstreamRequested))
+            SetBeforeUpscaleRequested(upstreamRequested);
+        ImGui::TextWrapped("Runs NR on the smaller image before DLSS. Compare detail and motion quality. NR still runs every frame.");
+        ImGui::TextDisabled("Requested placement: %s", BeforeUpscaleActive() ? "before upscaling" : "after upscaling");
+        if (BeforeUpscaleActive() != BeforeUpscaleRequested())
+            ImGui::TextWrapped("Restart the game to apply the new placement.");
+        ImGui::SeparatorText("Model quality and cost");
+        ImGui::TextWrapped("These changes rebuild the model. Sliders apply when released to avoid rebuilding on every drag step.");
+        DeferredSlider("Resolution scale (1 = 100%)", &config->DlssNrWorkingScale, 0.25f, 1.0f);
+        const char* styles[] = { "Standard", "Natural", "Cinematic" };
+        int style = std::min(2, static_cast<int>(config->DlssNrStyle.value_or_default()));
+        if (ImGui::Combo("Style", &style, styles, 3)) config->DlssNrStyle = static_cast<uint32_t>(style);
+        const char* presets[] = { "Default", "Preset 1", "Preset 2", "Preset 3" };
+        int preset = std::min(3, static_cast<int>(config->DlssNrPreset.value_or_default()));
+        if (ImGui::Combo("Model preset", &preset, presets, 4)) config->DlssNrPreset = static_cast<uint32_t>(preset);
+        DeferredSlider("Intensity", &config->DlssNrIntensity, 0.0f, 2.0f);
+        DeferredSlider("Local structure", &config->DlssNrLocalStructure, 0.0f, 2.0f);
+        DeferredSlider("Local tone", &config->DlssNrLocalTone, 0.0f, 2.0f);
+        DeferredSlider("Skin structure", &config->DlssNrSkinStructure, -1.0f, 2.0f);
+        bool mask = config->DlssNrAutoMask.value_or_default();
+        if (ImGui::Checkbox("Automatic skin mask", &mask)) config->DlssNrAutoMask = mask;
+        ImGui::TextDisabled("Style names are community labels for undocumented model profiles.");
+        ImGui::PopItemWidth();
+    }
+    ImGui::End();
+    ImGui::PopStyleColor(3);
+    return advanced;
+}
